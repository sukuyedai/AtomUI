<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Rate}" TargetType="atom:Rate">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="{x:Static atom:RateThemeConstants.FramePart}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <ItemsPresenter Name="{x:Static atom:RateThemeConstants.ItemsPresenterPart}">
                        <ItemsPresenter.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--
                                <atom:RateStackPanel></atom:RateStackPanel>
                                -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsPresenter.ItemsPanel>
                    </ItemsPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>